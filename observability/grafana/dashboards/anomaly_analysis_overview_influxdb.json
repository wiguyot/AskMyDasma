          "query": "groupSel = if \"${group}\" == \"\" then \"ALL\" else \"${group}\"\n\nbase =\n  from(bucket: \"hstree-analysis\")\n    |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n    |> filter(fn: (r) => r._measurement == \"hstree-analysis\")\n    |> filter(fn: (r) => groupSel == \"ALL\" or r.Group == groupSel)\n\nscore =\n  base\n    |> filter(fn: (r) => r._field == \"hstree_score\")\n    |> drop(columns: [\"host\", \"_measurement\", \"hstree_status\"])\n    |> map(fn: (r) => ({ r with _value: float(v: r._value) }))\n    |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n\nthreshold =\n  base\n    |> filter(fn: (r) => r._field == \"hstree_threshold\")\n    |> drop(columns: [\"host\", \"_measurement\", \"hstree_status\"])\n    |> map(fn: (r) => ({ r with _value: float(v: r._value) }))\n    |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n\nanomalies =\n  base\n    |> filter(fn: (r) => r._field == \"hstree_score\" and r.hstree_status == \"anomaly\")\n    |> drop(columns: [\"host\", \"_measurement\", \"hstree_status\"])\n    |> map(fn: (r) => ({ r with _field: \"hstree_anomaly_marker\", _value: float(v: r._value) }))\n    |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n\nunion(tables: [score, threshold, anomalies])\n  |> yield(name: \"hstree_analysis\")",
