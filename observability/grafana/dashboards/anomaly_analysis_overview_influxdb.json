          "query": "groupSel = if \"${group}\" == \"\" then \"ALL\" else \"${group}\"\n\n// Per-model consensus volume: one unit per model that raised at least one\n// anomaly vote inside the display window. This is a model-presence view, not an\n// event counter; repeated source_event_id values do not increase one model's bar.\n// When Group=ALL, sum the already windowed per-group flags directly by\n// _time/_field instead of running a second aggregateWindow.\n\nfrom(bucket: \"consensus-analysis\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"consensus-analysis\")\n  |> filter(fn: (r) => groupSel == \"ALL\" or r.Group == groupSel)\n  |> filter(fn: (r) => r._field =~ /^(hstree|iforest|kitnet|deepant|mdragpoint)_vote$/)\n  |> keep(columns: [\"_time\", \"_field\", \"_value\", \"Group\"])\n  |> map(fn: (r) => ({ r with _value: float(v: r._value) }))\n  |> group(columns: [\"Group\", \"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> group(columns: [\"_time\", \"_field\"])\n  |> sum(column: \"_value\")\n  |> group(columns: [\"_field\"])\n  |> yield(name: \"by_model\")",
          "refId": "A"
        }
