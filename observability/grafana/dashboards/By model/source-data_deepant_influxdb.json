      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-dasma"
          },
          "query": "import \"math\"\n\ngroupSel = if \"${group}\" == \"\" then \"ALL\" else \"${group}\"\n\nbase =\n  from(bucket: \"deepant-analysis\")\n    |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n    |> filter(fn: (r) => r._measurement == \"deepant-analysis\")\n    |> filter(fn: (r) => groupSel == \"ALL\" or r.Group == groupSel)\n\nscore =\n  base\n    |> filter(fn: (r) => r._field == \"deepant_score\")\n    |> drop(columns: [\"host\", \"_measurement\", \"deepant_status\"])\n    |> map(fn: (r) => ({ r with _field: \"deepant_score_log10\", _value: math.log10(x: float(v: r._value) + 1.0) }))\n    |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n\nthreshold =\n  base\n    |> filter(fn: (r) => r._field == \"deepant_threshold\")\n    |> drop(columns: [\"host\", \"_measurement\", \"deepant_status\"])\n    |> map(fn: (r) => ({ r with _field: \"deepant_threshold_log10\", _value: math.log10(x: float(v: r._value) + 1.0) }))\n    |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n\nanomalies =\n  base\n    |> filter(fn: (r) => r._field == \"deepant_score\" and r.deepant_status == \"anomaly\")\n    |> drop(columns: [\"host\", \"_measurement\", \"deepant_status\"])\n    |> map(fn: (r) => ({ r with _field: \"deepant_anomaly_marker_log10\", _value: math.log10(x: float(v: r._value) + 1.0) }))\n    |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n\nunion(tables: [score, threshold, anomalies])\n  |> yield(name: \"deepant_analysis\")",
          "refId": "A"
        }
      ],
      "title": "DeepAnT Analysis",
