          "query": "import \"strings\"\n\nfieldSel = if \"${feature}\" == \"\" then \"ALL\" else \"${feature}\"\ngroupSel = if \"${group}\" == \"\" then \"ALL\" else \"${group}\"\n\nban = [\"timestamp\",\"LabviewTime\",\"LabViewTime\",\"StepNumber\",\"Cycle\"]\n\nfrom(bucket: \"deepant-analysis\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"deepant-analysis\")\n  |> filter(fn: (r) => not contains(value: r._field, set: ban))\n  |> filter(fn: (r) => not strings.hasPrefix(v: r._field, prefix: \"deepant_\"))\n  |> filter(fn: (r) => fieldSel == \"ALL\" or r._field == fieldSel)\n  |> filter(fn: (r) => groupSel == \"ALL\" or r.Group == groupSel)\n  |> drop(columns: [\"host\", \"_measurement\", \"deepant_status\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)",
